{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "VEN-STATES RP Launcher",
  "version": "2.0.0-beta",
  "identifier": "com.vendatelostudio.venstates.launcher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "VEN-STATES RP Launcher",
        "width": 1285,
        "height": 732,
        "minWidth": 1032,
        "minHeight": 583,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": false,
        "devtools": false,
        "center": true,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "VEN-STATES RP Launcher"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "VENDATELO STUDIO",
    "copyright": "© 2026 halfik24",
    "shortDescription": "Лаунчер VEN-STATES RP",
    "longDescription": "VEN-STATES RP Launcher — отдельный лаунчер для собственной сборки GTA San Andreas Multiplayer. Он хранит настройки VEN-STATES отдельно и запускает игру напрямую.",
    "icon": [
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../wallpapers": "wallpapers"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "../src/header.bmp",
        "sidebarImage": "../src/wizard.bmp",
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "Belarusian",
          "Ukrainian",
          "English"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
